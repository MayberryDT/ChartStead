{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chartstead",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EVENT_STORE",
        "class_name": "EventStore"
      }
    ]
  },
  "exports": {
    "EventStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "chartstead-auth",
      "database_id": "fcd08e3c-fe5d-4c3c-a045-e1e1f7f2208d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "chartstead-assets"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://chartstead.mayberrydt.workers.dev"
  },
  "env": {
    "demo": {
      "name": "chartstead-demo",
      "main": "./worker/demo.ts",
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "EVENT_STORE",
            "class_name": "EventStore"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "chartstead-auth-demo",
          "database_id": "16b64284-0f9f-4270-a282-3db87667dbb8",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "chartstead-assets-demo"
        }
      ],
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
        "binding": "STATIC_ASSETS"
      },
      "workers_dev": true,
      "routes": [
        {
          "pattern": "demo.chartstead.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "BETTER_AUTH_URL": "https://demo.chartstead.com"
      }
    }
  }
}
